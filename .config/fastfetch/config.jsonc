{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "height": 16,
    "width": 16,
    "source": "windows",
    "type": "small",
    "color": {
      "1": "white",
      "2": "cyan",
      "3": "cyan",
      "4": "white",
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 1,
    },
  },
  "display": {
    "separator": " | ",
    "color": {
      "keys": "cyan",
      "title": "white",
    },
  },
  "modules": [
    // "title", naam van pc
    "break",
    "break",
    "title",
    {
      "type": "os",
      "format": "{name} {version}",
    },
    "separator",
    {
      "type": "host",
      "key": "MB",
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "display",
    "separator",
    "uptime",
    //"packages",
  ],
  //"de",
}
